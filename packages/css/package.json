{
  "name": "@design-atlas/css",
  "version": "0.1.0",
  "description": "CSS tokens, reset, base typography, and utility classes for Design Atlas design system",
  "type": "module",
  "main": "./dist/atl-style.css",
  "style": "./dist/atl-style.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/atl-style.css",
    "./atl-style.css": "./dist/atl-style.css",
    "./atl-reset.css": "./dist/atl-reset.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "clean": "rimraf dist",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@design-atlas/tokens": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.0"
  },
  "keywords": [
    "css",
    "design-system",
    "design-tokens",
    "styles",
    "ui"
  ],
  "author": "Design Atlas Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSMBrasil/design-atlas.git",
    "directory": "packages/css"
  }
}
